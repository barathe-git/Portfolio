###########################################################
# application-local.properties.example
#
# Copy this file to application-local.properties (same dir)
# and fill in real values. The real file is git-ignored.
# Spring Boot will automatically pick it up if you run with
# `--spring.profiles.active=local` or set SPRING_PROFILES_ACTIVE=local
###########################################################

# Runtime JSON data
portfolio.data.path=./data/portfolio.json

# Single administrator
admin.username=admin
admin.password=REPLACE_WITH_A_STRONG_PASSWORD
admin.email=
admin.phone=

# JWT configuration (REQUIRED for production)
jwt.secret=REPLACE_WITH_A_SECURE_RANDOM_64_CHAR_HEX
jwt.expiration=86400000
